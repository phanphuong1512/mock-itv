DATABASE_URL=sqlite:///./mockitv.db
OPENAI_ENDPOINT=https://aiportalapi.stu-platform.live/jpe
OPENAI_API_KEY=<your-openai-api-key-here>
OPENAI_MODEL=GPT-5.4

# TTS Configuration (optional)
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=nova

# Pinecone VectorDB Configuration
PINECONE_API_KEY=<your-pinecone-api-key-here>
PINECONE_INDEX_NAME=mockitv
EMBEDDING_API_KEY=<your-embedding-api-key-here>

# Auth Configuration
JWT_SECRET=mockitv-super-secret-jwt-key-2026
GOOGLE_CLIENT_ID=<your-google-oauth-client-id>